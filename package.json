{
  "name": "erp-pro",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently npm:server npm:client",
    "server": "nodemon server.js",
    "client": "cd src && npm run dev",
    "build": "cd src && npm install && npm run build",
    "start": "node server.js",
    "postinstall": "cd src && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
